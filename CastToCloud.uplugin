	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EnabledByDefault": true,
	"Modules": [
		{
			"Name": "CastToCloud",
			"Type": "Runtime",
			"PlatformAllowList": [ "Win64", "Mac", "Linux", "Android", "IOS" ],
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudShared",
			"Type": "Runtime",
			"PlatformAllowList": [ "Win64", "Mac", "Linux", "Android", "IOS" ],
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudAnalytics",
			"Type": "Runtime",
			"PlatformAllowList": [ "Win64", "Mac", "Linux", "Android", "IOS" ],
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudMetrics",
			"Type": "Runtime",
			"PlatformAllowList": [ "Win64", "Mac", "Linux", "Android", "IOS" ],
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudConnect",
			"Type": "Runtime",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudConnectEditor",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"Type": "Editor",
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudAnalyticsEditor",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"Type": "Editor",
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudSharedEditor",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"Type": "Editor",
			"LoadingPhase": "PreDefault"
		},
		{
			"Name": "CastToCloudMetricsEditor",
			"PlatformAllowList": [ "Win64", "Mac", "Linux" ],
			"Type": "Editor",
			"LoadingPhase": "PreDefault"
		}
	],
	"PreBuildSteps":
	{
		"Win64": [
			"powershell -ExecutionPolicy Bypass -File \"$(PluginDir)/Scripts/Cli/download.ps1\" \"$(PluginDir)\""
		],
		"Mac": [
			"chmod +x '$(PluginDir)/Scripts/Cli/download.sh'",
			"'$(PluginDir)/Scripts/Cli/download.sh' --plugin-dir '$(PluginDir)'"
		],
		"Linux": [
			"chmod +x '$(PluginDir)/Scripts/Cli/download.sh'",
			"'$(PluginDir)/Scripts/Cli/download.sh' --plugin-dir '$(PluginDir)'"
		]
	},
	"Plugins": [
		{
			"Name": "AnalyticsBlueprintLibrary",
			"Enabled": true
		},
		{
			"Name": "UdpMessaging",
			"Enabled": true
		}
	]
}
